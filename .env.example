# Copy this file to .env and fill in the values. .env is gitignored.

# Your Letterboxd username, from https://letterboxd.com/<username>/
LETTERBOXD_USERNAME=

# Your Plex account auth token. See CLAUDE.md "Getting a Plex token".
PLEX_TOKEN=

# Optional overrides (defaults shown):
# STATE_FILE=state/synced.json
# LOG_FILE=logs/sync.log
# UNMATCHED_RETRY_DAYS=14
# MATCH_SCORE_THRESHOLD=0.9
# YEAR_TOLERANCE=1
# Sync only the N most recently added films; 0 or unset syncs the whole list.
# WATCHLIST_LIMIT=0
# META_FILE=state/meta.json
# Set NOTIFY=0 to silence macOS notifications entirely.
# NOTIFY=1
# Days of silence before the job posts a "still running" heartbeat.
# HEARTBEAT_DAYS=30
