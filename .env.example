# Copy this file to .env and fill in the values. .env is gitignored.

# Your Letterboxd username, from https://letterboxd.com/<username>/
LETTERBOXD_USERNAME=

# Your Plex account auth token. See CLAUDE.md "Getting a Plex token".
PLEX_TOKEN=

# Optional overrides (defaults shown):
# STATE_FILE=state/synced.json
# LOG_FILE=logs/sync.log
# UNMATCHED_RETRY_DAYS=14
# MATCH_SCORE_THRESHOLD=0.9
# YEAR_TOLERANCE=1
