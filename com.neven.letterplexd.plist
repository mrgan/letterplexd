<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.neven.letterplexd</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/neven/Developer/letterplexd/venv/bin/python3</string>
        <string>/Users/neven/Developer/letterplexd/sync.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/neven/Developer/letterplexd</string>

    <!-- Run once at load, then every 14400 seconds (4 hours). -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>14400</integer>

    <key>StandardOutPath</key>
    <string>/Users/neven/Developer/letterplexd/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/neven/Developer/letterplexd/logs/launchd.err.log</string>
</dict>
</plist>
